text = ""
autowrap_mode = 3

[node name="Sep" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ExitsTitle" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"CapsLabel"
text = "PATHS"

[node name="Exits" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = ""
autowrap_mode = 3

[node name="KeysTitle" type="Label" parent="VBox"]
layout_mode = 2
