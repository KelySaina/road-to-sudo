[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/objective_panel.gd" id="1_obj"]

[node name="ObjectivePanel" type="PanelContainer"]
size_flags_vertical = 3
script = ExtResource("1_obj")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Level" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CapsLabel"
text = "LEVEL 0 · FIRST CONTACT"

[node name="Steps" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FaintLabel"
text = "●○○○○○○○○○"

[node name="Title" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Objective"
autowrap_mode = 3

[node name="Objective" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
text = ""
autowrap_mode = 3

[node name="Status" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = ""
autowrap_mode = 3

[node name="Sep" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="HintsTitle" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CapsLabel"
text = "HINTS 0/3"

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Hints" type="VBoxContainer" parent="VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HintButton" type="Button" parent="VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "Hint  F1"

[node name="SolutionButton" type="Button" parent="VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "Solution"

[node name="ResetButton" type="Button" parent="VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Rewind the machine to the start of this challenge (:reset)"
text = "⟲"

[node name="ContinueButton" type="Button" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
theme_type_variation = &"MenuButtonBig"
text = "Continue  ⏎"
