[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/terminal_view.gd" id="1_term"]

[node name="Terminal" type="PanelContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"TerminalPanel"
script = ExtResource("1_term")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" type="PanelContainer" parent="VBox"]
layout_mode = 2
theme_type_variation = &"TitleBarPanel"

[node name="Row" type="HBoxContainer" parent="VBox/TitleBar"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Dots" type="Label" parent="VBox/TitleBar/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FaintLabel"
text = "● ● ●"

[node name="TitleText" type="Label" parent="VBox/TitleBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
text = "player@localhost: ~"
horizontal_alignment = 1

[node name="Keys" type="Label" parent="VBox/TitleBar/Row"]
layout_mode = 2
theme_type_variation = &"FaintLabel"
text = "Tab complete · ↑↓ history · Ctrl+L clear"

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Stack" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Output" type="RichTextLabel" parent="VBox/Body/Stack"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
bbcode_enabled = true
scroll_following = true
selection_enabled = true
context_menu_enabled = true

[node name="InputRow" type="HBoxContainer" parent="VBox/Body/Stack"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="PromptUser" type="Label" parent="VBox/Body/Stack/InputRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
text = "player@localhost"

[node name="PromptPath" type="Label" parent="VBox/Body/Stack/InputRow"]
unique_name_in_owner = true
layout_mode = 2
text = ":~"

[node name="PromptSymbol" type="Label" parent="VBox/Body/Stack/InputRow"]
unique_name_in_owner = true
layout_mode = 2
text = "$ "

[node name="Input" type="LineEdit" parent="VBox/Body/Stack/InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
context_menu_enabled = false
virtual_keyboard_enabled = false
caret_blink = true
caret_blink_interval = 0.55

[node name="Suggestion" type="Label" parent="VBox/Body/Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FaintLabel"
clip_text = true
