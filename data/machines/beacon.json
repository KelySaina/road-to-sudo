{
  "hostname": "beacon-01",
  "users": {
    "root": {
      "uid": 0,
      "gid": 0,
      "groups": [
        "root"
      ],
      "home": "/root",
      "shell": "/bin/bash",
      "gecos": "root"
    },
    "player": {
      "uid": 1000,
      "gid": 1000,
      "groups": [
        "player",
        "users"
      ],
